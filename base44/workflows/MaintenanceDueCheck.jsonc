{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "maintenance_due_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_maintenance": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkMaintenanceDue",
            "args": {
              "secret": "${ secrets.MAINTENANCE_CHECK_SECRET }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check maintenance due",
            "description": "Scan vehicle odometers for 10,000 km intervals"
          }
        }
      }
    ]
  },
  "name": "Maintenance Due Check",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Asia/Dubai",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily check for vehicles approaching 10,000 km maintenance intervals with 500km buffer"
}