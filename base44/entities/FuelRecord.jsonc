{
  "name": "FuelRecord",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "vehicle_name": {
      "type": "string",
      "title": "Vehicle Name"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "fuel_date": {
      "type": "string",
      "format": "date",
      "title": "Fuel Date"
    },
    "station": {
      "type": "string",
      "title": "Station"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "super_98",
        "special_95",
        "eplus_91",
        "diesel"
      ],
      "title": "Fuel Type"
    },
    "fuel_rate": {
      "type": "number",
      "title": "Fuel Rate (AED/L)"
    },
    "litres": {
      "type": "number",
      "title": "Litres"
    },
    "cost": {
      "type": "number",
      "title": "Cost"
    },
    "odometer": {
      "type": "number",
      "title": "Odometer Reading"
    },
    "efficiency_kmpl": {
      "type": "number",
      "title": "Efficiency (km/l)"
    },
    "receipt_url": {
      "type": "string",
      "title": "Receipt URL"
    }
  },
  "required": [
    "vehicle_name",
    "fuel_date",
    "litres",
    "cost"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}