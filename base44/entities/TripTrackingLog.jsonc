{
  "name": "TripTrackingLog",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "title": "Trip ID"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude"
    },
    "timestamp": {
      "type": "string",
      "title": "Timestamp"
    },
    "trust_score": {
      "type": "number",
      "title": "Trust Score"
    },
    "accuracy": {
      "type": "number",
      "title": "Accuracy (m)"
    },
    "gps_metadata": {
      "type": "string",
      "title": "GPS Metadata"
    },
    "is_valid": {
      "type": "boolean",
      "default": true,
      "title": "Is Valid Point"
    }
  },
  "required": [
    "trip_id",
    "latitude",
    "longitude",
    "timestamp"
  ]
}