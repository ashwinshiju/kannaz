{
  "name": "Trip",
  "type": "object",
  "properties": {
    "trip_number": {
      "type": "string",
      "title": "Trip Number"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "employee_ref_id": {
      "type": "string",
      "title": "Employee Reference ID"
    },
    "employee_unlinked": {
      "type": "boolean",
      "default": false,
      "title": "Employee Unlinked (No Match Found)"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehicle ID"
    },
    "vehicle_name": {
      "type": "string",
      "title": "Vehicle Name"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "start_location": {
      "type": "string",
      "title": "Start Location"
    },
    "end_location": {
      "type": "string",
      "title": "End Location"
    },
    "start_location_preset_id": {
      "type": "string",
      "title": "Start Location Preset ID"
    },
    "end_location_preset_id": {
      "type": "string",
      "title": "End Location Preset ID"
    },
    "start_lat": {
      "type": "number",
      "title": "Start Latitude"
    },
    "start_lng": {
      "type": "number",
      "title": "Start Longitude"
    },
    "end_lat": {
      "type": "number",
      "title": "End Latitude"
    },
    "end_lng": {
      "type": "number",
      "title": "End Longitude"
    },
    "start_trust_score": {
      "type": "number",
      "title": "Start GPS Trust Score"
    },
    "start_gps_metadata": {
      "type": "string",
      "title": "Start GPS Validation Metadata"
    },
    "end_trust_score": {
      "type": "number",
      "title": "End GPS Trust Score"
    },
    "end_gps_metadata": {
      "type": "string",
      "title": "End GPS Validation Metadata"
    },
    "odometer_manually_entered": {
      "type": "boolean",
      "default": false,
      "title": "Start Odometer Manually Entered"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "official",
        "personal",
        "maintenance"
      ],
      "default": "official",
      "title": "Purpose"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "in_progress",
        "completed",
        "acknowledged",
        "cancelled"
      ],
      "default": "created",
      "title": "Status"
    },
    "start_odometer": {
      "type": "number",
      "title": "Start Odometer"
    },
    "end_odometer": {
      "type": "number",
      "title": "End Odometer"
    },
    "distance_km": {
      "type": "number",
      "title": "Distance (km)"
    },
    "tracked_distance_km": {
      "type": "number",
      "title": "Tracked Distance (km)"
    },
    "low_tracking_data": {
      "type": "boolean",
      "default": false,
      "title": "Low Tracking Data"
    },
    "tracking_gaps": {
      "type": "string",
      "title": "Tracking Gaps (JSON)"
    },
    "tracking_gap_count": {
      "type": "number",
      "title": "Tracking Gap Count"
    },
    "raw_points_captured": {
      "type": "number",
      "title": "Raw Points Captured"
    },
    "valid_points_count": {
      "type": "number",
      "title": "Valid Points Count"
    },
    "discarded_jump_count": {
      "type": "number",
      "title": "Discarded \u2014 Jump Detection"
    },
    "discarded_low_trust_count": {
      "type": "number",
      "title": "Discarded \u2014 Low Trust Score"
    },
    "discarded_spoofed_count": {
      "type": "number",
      "title": "Discarded \u2014 Spoofing Protection"
    },
    "distance_mismatch": {
      "type": "boolean",
      "default": false,
      "title": "Distance Mismatch"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (min)"
    },
    "started_at": {
      "type": "string",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At"
    },
    "acknowledged_at": {
      "type": "string",
      "title": "Acknowledged At"
    },
    "acknowledged_by": {
      "type": "string",
      "title": "Acknowledged By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "manager_id": {
      "type": "string",
      "title": "Manager ID"
    }
  },
  "required": [
    "employee_name",
    "vehicle_name",
    "start_location",
    "end_location"
  ]
}